# VNC-enabled Docker image for DAVE with web access
FROM ubuntu:22.04

# Install desktop environment and VNC server
RUN apt-get update && apt-get install -y \
    # Desktop environment
    xfce4 \
    xfce4-terminal \
    # VNC server
    tigervnc-standalone-server \
    tigervnc-common \
    novnc \
    websockify \
    # Python and Node.js
    python3.13 \
    python3-pip \
    curl \
    # Electron dependencies
    libgtk-3-0 \
    libnotify4 \
    libnss3 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    libatspi2.0-0 \
    libdrm2 \
    libgbm1 \
    libxcb-dri3-0 \
    libasound2 \
    # Utilities
    supervisor \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# Install Pixi
RUN curl -fsSL https://pixi.sh/install.sh | bash && \
    echo 'export PATH="$HOME/.pixi/bin:$PATH"' >> /etc/bash.bashrc

# Create user
RUN useradd -m -s /bin/bash dave && \
    echo "dave:dave" | chpasswd

# Set up VNC
RUN mkdir -p /home/dave/.vnc && \
    echo "dave" | vncpasswd -f > /home/dave/.vnc/passwd && \
    chmod 600 /home/dave/.vnc/passwd && \
    chown -R dave:dave /home/dave/.vnc

# Copy application files
WORKDIR /home/dave/app
COPY --chown=dave:dave . .

# Install dependencies as dave user
USER dave
RUN export PATH="$HOME/.pixi/bin:$PATH" && \
    pixi install && \
    cd src/main/js/electron && npm install

# Switch back to root for supervisor setup
USER root

# Create supervisor configuration
RUN echo '[supervisord]\n\
nodaemon=true\n\
user=root\n\
\n\
[program:xvfb]\n\
command=/usr/bin/Xvfb :1 -screen 0 1280x1024x24\n\
autorestart=true\n\
user=dave\n\
priority=100\n\
\n\
[program:x11vnc]\n\
command=/usr/bin/x11vnc -display :1 -noxrecord -noxfixes -noxdamage -forever -rfbauth /home/dave/.vnc/passwd -rfbport 5900 -shared\n\
autorestart=true\n\
user=dave\n\
priority=200\n\
\n\
[program:novnc]\n\
command=/usr/share/novnc/utils/novnc_proxy --vnc localhost:5900 --listen 6080\n\
autorestart=true\n\
user=dave\n\
priority=300\n\
\n\
[program:xfce4]\n\
command=/usr/bin/startxfce4\n\
autorestart=true\n\
user=dave\n\
environment=DISPLAY=":1",HOME="/home/dave"\n\
priority=400\n\
\n\
[program:flask]\n\
command=/home/dave/.pixi/envs/default/bin/python /home/dave/app/src/main/python/server.py . . 5000 0\n\
directory=/home/dave/app\n\
autorestart=true\n\
user=dave\n\
environment=HOME="/home/dave",PATH="/home/dave/.pixi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n\
priority=500\n\
\n\
[program:electron]\n\
command=/usr/bin/npm start\n\
directory=/home/dave/app/src/main/js/electron\n\
autorestart=true\n\
user=dave\n\
environment=DISPLAY=":1",HOME="/home/dave",ELECTRON_DISABLE_SANDBOX="1"\n\
priority=600\n\
startsecs=10\n\
' > /etc/supervisor/conf.d/supervisord.conf

# Expose ports
EXPOSE 5900 6080 5000

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]